---
import Base from '../layouts/Base.astro';
import SiteRail from '../components/SiteRail.astro';
import { projects, roles, stack } from '../data/projects';
import { getWriting, FEED, LIMIT } from '../data/writing';

const writing = await getWriting();
---

<Base>
  <div class="shell">
    <SiteRail />

    <main class="pane" id="main" tabindex="-1">
      <div class="pane-inner">
        <section class="sect" id="projects">
          <div class="sect-head">
            <h2>项目</h2><span class="en">Projects</span>
            <a class="more lat" href="https://github.com/hmilyld">全部仓库</a>
          </div>

          <ul class="rows">
            {projects.map((project) => (
              <li class="row">
                <div class="row-main">
                  <h3 class="lat"><a href={project.url}>{project.name}</a></h3>
                  <p>{project.description}</p>
                </div>
                <div class="row-meta">
                  <span class="zh is-active">{project.status}</span>
                  <span>{project.tech}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="sect" id="writing">
          <div class="sect-head">
            <h2>写作</h2><span class="en">Writing</span>
            <a class="more lat" href="https://hmilyld.com">hmilyld.com</a>
          </div>

          <ul class="rows" id="writing-list" data-feed={FEED} data-limit={LIMIT}>
            {writing.posts.map((post) => (
              <li class="row">
                <div class="row-main">
                  <h3><a href={post.link}>{post.title}</a></h3>
                </div>
                <div class="row-meta">
                  {post.category && <span class="zh">{post.category}</span>}
                  <time datetime={post.datetime}>{post.date}</time>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="sect" id="about">
          <div class="sect-head">
            <h2>关于</h2><span class="en">Profile</span>
            <a class="more lat" href="https://hmilyld.com/about">博客里的我</a>
          </div>

          <ul class="rows">
            {roles.map((role) => (
              <li class="row">
                <div class="row-main">
                  <h3>{role.org}</h3>
                </div>
                <div class="row-meta">
                  <span>{role.years}</span>
                </div>
              </li>
            ))}
          </ul>

          <div class="stack">
            {stack.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </section>

        <section class="sect" id="contact">
          <div class="sect-head">
            <h2>联系</h2><span class="en">Contact</span>
          </div>

          <p class="lead">
            这个域名是身份层，写东西在 hmilyld.com。合作或闲聊都可以写信。
          </p>

          <div class="contact-links">
            <a href="mailto:Hmilyld@gmail.com">Hmilyld@gmail.com</a>
            <a href="https://github.com/hmilyld" rel="me">github.com/hmilyld</a>
            <a href="https://hmilyld.com" rel="me">hmilyld.com</a>
            <a href="https://hmilyld.com/rss.xml">RSS</a>
          </div>
        </section>

        <footer class="colophon">
          本站用 Astro 构建，部署在 Debian + Docker + Nginx。
          <span class="d">© 2026 胡志刚</span>
        </footer>
      </div>
    </main>
  </div>

  <script>
    import { parseRssItems } from '../lib/rss.js';

    interface Post {
      title: string;
      link: string;
      date: string;
      datetime: string;
      category: string;
    }

    // The 写作 list is rendered at build time; refresh it from the live feed on
    // each visit so new posts show up without a rebuild. If the blog is
    // unreachable the build-time snapshot stays in place.
    const list = document.getElementById('writing-list');
    const feed = list?.dataset.feed;
    const limit = Number(list?.dataset.limit ?? 5);

    if (list && feed) {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 8000);

      try {
        const response = await fetch(feed, { signal: controller.signal, redirect: 'follow' });

        if (response.ok) {
          const posts = parseRssItems(await response.text(), limit) as Post[];
          const current = list.querySelector('a')?.getAttribute('href');

          // Only touch the DOM when the feed actually has newer content.
          if (posts.length > 0 && posts[0].link !== current) {
            list.replaceChildren(...posts.map(renderRow));
          }
        }
      } catch {
        // Keep what was rendered at build time.
      } finally {
        clearTimeout(timer);
      }
    }

    function renderRow(post: Post): HTMLLIElement {
      const row = document.createElement('li');
      row.className = 'row';

      const main = document.createElement('div');
      main.className = 'row-main';

      const heading = document.createElement('h3');
      const link = document.createElement('a');
      link.href = post.link;
      link.textContent = post.title;
      heading.append(link);
      main.append(heading);

      const meta = document.createElement('div');
      meta.className = 'row-meta';

      if (post.category) {
        const category = document.createElement('span');
        category.className = 'zh';
        category.textContent = post.category;
        meta.append(category);
      }

      const time = document.createElement('time');
      time.dateTime = post.datetime;
      time.textContent = post.date;
      meta.append(time);

      row.append(main, meta);
      return row;
    }
  </script>
</Base>
