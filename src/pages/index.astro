---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';

const name = '胡志刚';
const pinyin = 'Hu Zhigang';
// TODO: replace with the real one-line self-description.
const intro = '写点东西，也做点东西。';
---

<Base>
  <main
    class="flex min-h-dvh flex-col justify-end px-[clamp(1.5rem,7vw,8rem)] pb-[clamp(1.75rem,5vh,3.5rem)] pt-24"
  >
    <div class="flex flex-col">
      <h1
        class="reveal flex items-end gap-[0.16em] text-name leading-[0.98] tracking-[0.04em]"
      >
        <span>{name}</span>
        <Seal />
      </h1>

      <p
        class="reveal reveal-late mt-[clamp(0.9rem,2vw,1.4rem)] font-newsreader text-pinyin tracking-[0.14em] text-ink-soft"
      >
        {pinyin}
      </p>

      <p class="reveal reveal-later mt-[clamp(1.75rem,4vw,2.75rem)] max-w-[26em] text-line leading-[1.9]">
        {intro}
      </p>
    </div>

    <footer class="mt-[clamp(3rem,9vh,6rem)] border-t border-rule pt-4">
      <a
        class="link font-newsreader text-[0.95rem] tracking-[0.02em]"
        href="https://hmilyld.com"
        rel="me"
      >
        写作在 hmilyld.com
      </a>
    </footer>
  </main>
</Base>
