---
import '@fontsource-variable/overpass/wght.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = '胡志刚 · Hu Zhigang',
  description = '胡志刚（河南周口沈丘）的个人主页：开源项目、工具与写作。写东西在 hmilyld.com。',
  keywords = '胡志刚, 河南胡志刚, 郑州胡志刚, 周口胡志刚, 沈丘胡志刚, Hu Zhigang, Hmilyld',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://huzhigang.com');
const ogImage = new URL('/og.png', canonical).href;

const person = {
  '@type': 'Person',
  '@id': `${canonical.origin}/#person`,
  name: '胡志刚',
  alternateName: ['Hu Zhigang', 'Hmilyld'],
  url: canonical.href,
  image: ogImage,
  sameAs: ['https://hmilyld.com', 'https://github.com/hmilyld'],
  jobTitle: '全栈开发',
  knowsLanguage: ['zh-CN'],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CN',
    addressRegion: '河南省',
    addressLocality: '周口市沈丘县',
  },
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${canonical.origin}/#website`,
      url: `${canonical.origin}/`,
      name: title,
      description,
      inLanguage: 'zh-CN',
      publisher: { '@id': person['@id'] },
    },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 浏览器在渲染前就知道两套配色都支持，避免白闪；无 JS 时保持 light dark */}
    <meta name="color-scheme" content="light dark" />
    {/* 允许浏览器按系统字号缩放整个页面（Chrome 146+） */}
    <meta name="text-scale" content="scale" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eeede9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1c1e" media="(prefers-color-scheme: dark)" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="小胡日记 · hmilyld.com"
      href="https://hmilyld.com/rss.xml"
    />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="胡志刚 · Hu Zhigang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="胡志刚 · Hu Zhigang — 写代码，做工具，偶尔写点东西。" />
    <meta property="profile:first_name" content="志刚" />
    <meta property="profile:last_name" content="胡" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />

    {/* 绘制前定好明暗：meta 是唯一真相，CSS 用 :has() 跟随它。 */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const value = stored === 'light' || stored === 'dark' ? stored : 'light dark';
          document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', value);
          if (value !== 'light dark') {
            const color = value === 'dark' ? '#1a1c1e' : '#eeede9';
            document
              .querySelectorAll('meta[name="theme-color"]')
              .forEach((meta) => meta.setAttribute('content', color));
          }
        } catch (error) {
          // 存储被禁用时保持 light dark，跟随系统即可，不影响渲染。
          console.debug('theme preference unavailable:', error);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <slot />

    <script>
      const scheme = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
      const themeColors = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
      const choices = [...document.querySelectorAll<HTMLButtonElement>('.theme [data-theme-value]')];
      const system = window.matchMedia('(prefers-color-scheme: dark)');
      const THEME_COLORS = { light: '#eeede9', dark: '#1a1c1e' };

      function storedMode(): 'system' | 'light' | 'dark' {
        try {
          const value = localStorage.getItem('theme');
          return value === 'light' || value === 'dark' ? value : 'system';
        } catch (error) {
          console.debug('theme preference unavailable:', error);
          return 'system';
        }
      }

      function syncThemeColor(mode: 'system' | 'light' | 'dark', dark: boolean) {
        // 两条 meta 各自带 media，让浏览器在无 JS 时也能选对颜色。
        // 手动锁定时把两条都改成同一个色，谁匹配都得到锁定色。
        const pinned = mode === 'system' ? null : dark ? THEME_COLORS.dark : THEME_COLORS.light;
        themeColors.forEach((meta, index) => {
          const fallback = index === 0 ? THEME_COLORS.light : THEME_COLORS.dark;
          meta.setAttribute('content', pinned ?? fallback);
        });
      }

      function applyTheme() {
        const mode = storedMode();
        const dark = mode === 'dark' || (mode === 'system' && system.matches);

        // 「自动」交还给浏览器：light dark 让系统自己决定。
        scheme?.setAttribute('content', mode === 'system' ? 'light dark' : mode);
        choices.forEach((choice) => {
          choice.setAttribute('aria-pressed', String(choice.dataset.themeValue === mode));
        });
        syncThemeColor(mode, dark);
      }

      choices.forEach((choice) => {
        choice.addEventListener('click', () => {
          const mode = choice.dataset.themeValue ?? 'system';
          try {
            // 回到自动时删掉记录，否则会把系统偏好永久钉死。
            if (mode === 'system') localStorage.removeItem('theme');
            else localStorage.setItem('theme', mode);
          } catch (error) {
            console.debug('theme preference not saved:', error);
          }
          applyTheme();
        });
      });

      // While on 自动, follow the system as it changes during the visit.
      system.addEventListener('change', () => {
        if (storedMode() === 'system') applyTheme();
      });

      // Another tab changed the preference.
      window.addEventListener('storage', (event) => {
        if (event.key === 'theme') applyTheme();
      });

      applyTheme();
    </script>
  </body>
</html>
