---
import Seal from './Seal.astro';
import RailContent from './RailContent.astro';
---

<header class="mobilebar">
  <div class="rail-mark">
    <Seal />
    <div class="rail-who">
      {/* 窄屏下侧栏是 display:none，页面标题由顶栏承担 */}
      <h1 class="bar-name">胡志刚</h1>
      <span class="lat-sub" lang="en">HU ZHIGANG</span>
    </div>
  </div>
  <button
    class="menu-toggle btn"
    type="button"
    aria-expanded="false"
    aria-controls="site-drawer"
    data-drawer-open
  >
    目录
  </button>
</header>

<aside class="rail" id="site-rail">
  <RailContent />
</aside>

{/* 移动端：原生 dialog 自带焦点陷阱、Esc、焦点归还与 ::backdrop */}
<dialog class="drawer" id="site-drawer" aria-label="目录">
  <RailContent variant="drawer" heading="p" />
</dialog>

<script>
  // ── drawer: native <dialog>, so modality is the browser's job ──
  const drawer = document.querySelector<HTMLDialogElement>('#site-drawer');
  const menu = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const wide = window.matchMedia('(min-width: 861px)');

  if (drawer && menu) {
    const openDrawer = () => {
      drawer.showModal();
      menu.setAttribute('aria-expanded', 'true');
    };

    const closeDrawer = () => {
      if (drawer.open) drawer.close();
    };

    menu.addEventListener('click', () => {
      if (drawer.open) closeDrawer();
      else openDrawer();
    });

    // showModal() 已经把焦点移进 dialog，关闭时浏览器会还给触发者；
    // 只在按钮可见（窄屏）时才额外补一次，避免宽屏抢焦点。
    drawer.addEventListener('close', () => {
      menu.setAttribute('aria-expanded', 'false');
      if (!wide.matches) menu.focus();
    });

    // 抽屉内的关闭按钮和导航链接都要能收起来。
    drawer.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('[data-drawer-close]') || target.closest('.rail-nav a')) {
        closeDrawer();
        return;
      }
      // 点 ::backdrop 时事件目标就是 dialog 本身，但点 dialog 的内边距也一样；
      // 用坐标判断是否落在抽屉框外，只有真正点遮罩才关。
      if (target === drawer) {
        const rect = drawer.getBoundingClientRect();
        const outside =
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom;
        if (outside) closeDrawer();
      }
    });

    // 视口变宽时抽屉已无意义，顺手关掉。
    wide.addEventListener('change', (event) => {
      if (event.matches) closeDrawer();
    });
  }

  // ── scroll-spy: highlight the section being read ─────
  // 侧栏与抽屉各有一份导航，两份都要同步高亮。
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail-nav a')];
  const targets = [...new Set(links.map((link) => link.getAttribute('href') ?? ''))]
    .map((href) => document.querySelector<HTMLElement>(href))
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length > 0) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        const active = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    let clickLocked = false;
    let queued = false;

    const update = () => {
      queued = false;
      if (clickLocked) return;

      // The last section can never reach the reading line on a short page,
      // so take it explicitly once the page is scrolled to the end.
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      if (atBottom) {
        setActive(targets[targets.length - 1].id);
        return;
      }

      const line = window.innerHeight * 0.28;
      let current = targets[0].id;
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= line) current = target.id;
      }
      setActive(current);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    // A click knows the intent better than any position rule; hold it until the
    // visitor actually scrolls again.
    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return;
        setActive(id);
        clickLocked = true;
      });
    });

    ['wheel', 'touchmove', 'keydown'].forEach((event) => {
      window.addEventListener(
        event,
        () => {
          if (!clickLocked) return;
          clickLocked = false;
          onScroll();
        },
        { passive: true }
      );
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
